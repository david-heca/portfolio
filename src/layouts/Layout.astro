---
import { ClientRouter } from "astro:transitions";
import { getHome, localizePath, useTranslations, type Lang } from "@i18n/utils";
import Navbar from "@ui/Navbar.astro";
import { channels, email } from "@/data/contact";
import LanguageHint from "@ui/LanguageHint.astro";
// Junicode se autoaloja (no está en Fontsource): su @font-face vive en global.css.
import "@fontsource-variable/outfit/wght.css";
import "@fontsource/maple-mono/latin-400.css";
import "@styles/global.css";

export interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Solo para <title>; og:/twitter: siguen usando `title`. */
  tabTitle?: string;
  /** Fuera del índice: sin canonical ni hreflang, que solo valen para páginas reales. */
  noindex?: boolean;
}

const { title, description, lang, tabTitle = title, noindex = false } = Astro.props;
const t = useTranslations(lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/assets/dh.webp", Astro.site);

// El 404 se sirve bajo cualquier ruta, así que el pathname que congela el build no
// identifica nada: ahí el equivalente en el otro idioma solo puede ser su portada.
const pathname = Astro.url.pathname;
const esPath = noindex ? getHome("es") : localizePath(pathname, "es");
const enPath = noindex ? getHome("en") : localizePath(pathname, "en");
const esURL = new URL(esPath, Astro.site);
const enURL = new URL(enPath, Astro.site);
const switchTo = lang === "es" ? enPath : esPath;

const ogLocale = lang === "es" ? "es_MX" : "en_US";
const ogLocaleAlt = lang === "es" ? "en_US" : "es_MX";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "David Herrera",
  alternateName: "David Herrera del Castillo",
  url: Astro.site?.toString().replace(/\/$/, ""),
  image: socialImageURL.toString(),
  jobTitle: "Applied AI Engineer",
  description: description,
  worksFor: {
    "@type": "Organization",
    name: "Hypertech",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Mexico City",
    addressCountry: "MX",
  },
  email: `mailto:${email}`,
  knowsAbout: [
    "Software Engineering",
    "Artificial Intelligence",
    "Large Language Models",
    "Retrieval-Augmented Generation",
    "Model Context Protocol",
    "MLOps",
    ".NET",
    "Python",
    "TypeScript",
    "React",
    "Azure",
    "PostgreSQL",
  ],
  knowsLanguage: ["es", "en"],
  sameAs: channels.map((c) => c.href),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <meta name="author" content="David Herrera" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    <!-- Sin media query: lo pinta el script del tema, para que la barra del
         navegador siga al tema elegido y no al del sistema. -->
    <meta name="theme-color" content="#ffffff" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    {!noindex && (
      <>
        <link rel="canonical" href={canonicalURL} />

        <link rel="alternate" hreflang="es" href={esURL} />
        <link rel="alternate" hreflang="en" href={enURL} />
        <link rel="alternate" hreflang="x-default" href={esURL} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="David Herrera" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="David Herrera" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="David Herrera" />
    <meta name="twitter:creator" content="@david_heca_" />
    <meta name="twitter:site" content="@david_heca_" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />

    <title>{tabTitle}</title>

    <ClientRouter />

    <script is:inline>
      /* Única implementación de "pintar el tema": la clase, la preferencia y el
         color de la barra del navegador. `ThemeToggle` solo decide cuál toca. */
      (function () {
        var KEY = "color-theme";
        var media = window.matchMedia("(prefers-color-scheme: dark)");
        var root = document.documentElement;

        function pref() {
          try {
            var v = localStorage.getItem(KEY);
            return v === "light" || v === "dark" ? v : "system";
          } catch (e) {
            return "system";
          }
        }

        function paint(p) {
          var dark = p === "dark" || (p === "system" && media.matches);
          root.classList.toggle("dark", dark);
          root.dataset.themePref = p;
          // Mismo valor que `--color-bg`. Va literal: en la primera pasada la hoja
          // de estilos todavía no ha cargado y no se puede leer el token.
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", dark ? "#000000" : "#ffffff");
        }

        window.__theme = { key: KEY, pref: pref, paint: paint };

        // Los scripts inline de <head> no se reejecutan al hacer swap: el documento
        // nuevo hereda lo ya pintado para que no parpadee antes de `after-swap`.
        document.addEventListener("astro:before-swap", function (e) {
          var next = e.newDocument.documentElement;
          if (root.classList.contains("dark")) next.classList.add("dark");
          next.dataset.themePref = root.dataset.themePref || "system";
        });
        document.addEventListener("astro:after-swap", function () { paint(pref()); });

        // `addEventListener` sobre MediaQueryList falta en Safari < 14: sin la guarda
        // el script muere aquí y la página carga sin tema.
        if (media.addEventListener) {
          media.addEventListener("change", function () {
            if (pref() === "system") paint("system");
          });
        }

        paint(pref());
      })();
    </script>

    <!-- Redirige solo con preferencia explícita: autodetectar aquí sacaría a los
         rastreadores de "/", que es el canonical y el x-default. Las dos rutas
         llegan resueltas para no reimplementar el mapeo es↔en en el cliente.
         Fuera del índice no corre: convertiría el 404 en un 200 en otra URL. -->
    {!noindex && (
      <script is:inline define:vars={{ lang, esPath, enPath }}>
        var stored = localStorage.getItem("preferred-lang");
        if ((stored === "es" || stored === "en") && stored !== lang) {
          window.location.replace(stored === "es" ? esPath : enPath);
        }
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t("common.skipToContent")}</a>

    <Navbar lang={lang} switchTo={switchTo} />

    <main id="main" class="page">
      <slot />
    </main>

    <!-- Fuera de <main>: dentro no cuenta como landmark `contentinfo`. -->
    <slot name="footer" />

    <LanguageHint lang={lang} href={switchTo} />
  </body>
</html>
