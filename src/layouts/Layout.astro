---
import { ClientRouter } from "astro:transitions";
import { getHome, localizePath, useTranslations, type Lang } from "@i18n/utils";
import Navbar from "@ui/Navbar.astro";
import { channels, email } from "@/data/contact";
import LanguageHint from "@ui/LanguageHint.astro";
// Junicode se autoaloja (no está en Fontsource): su @font-face vive en global.css.
import "@fontsource-variable/outfit/wght.css";
import "@fontsource/maple-mono/latin-400.css";
import "@styles/global.css";

export interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Solo para <title>; og:/twitter: siguen usando `title`. */
  tabTitle?: string;
  /** Fuera del índice: sin canonical ni hreflang, que solo valen para páginas reales. */
  noindex?: boolean;
}

const { title, description, lang, tabTitle = title, noindex = false } = Astro.props;
const t = useTranslations(lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/assets/dh.webp", Astro.site);

// El 404 se sirve bajo cualquier ruta, así que el pathname que congela el build no
// identifica nada: ahí el equivalente en el otro idioma solo puede ser su portada.
const pathname = Astro.url.pathname;
const esPath = noindex ? getHome("es") : localizePath(pathname, "es");
const enPath = noindex ? getHome("en") : localizePath(pathname, "en");
const esURL = new URL(esPath, Astro.site);
const enURL = new URL(enPath, Astro.site);
const switchTo = lang === "es" ? enPath : esPath;

const ogLocale = lang === "es" ? "es_MX" : "en_US";
const ogLocaleAlt = lang === "es" ? "en_US" : "es_MX";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "David Herrera",
  alternateName: "David Herrera del Castillo",
  url: Astro.site?.toString().replace(/\/$/, ""),
  image: socialImageURL.toString(),
  jobTitle: "Applied AI Engineer",
  description: description,
  worksFor: {
    "@type": "Organization",
    name: "Hypertech",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Mexico City",
    addressCountry: "MX",
  },
  email: `mailto:${email}`,
  knowsAbout: [
    "Software Engineering",
    "Artificial Intelligence",
    "Large Language Models",
    "Retrieval-Augmented Generation",
    "Model Context Protocol",
    "MLOps",
    ".NET",
    "Python",
    "TypeScript",
    "React",
    "Azure",
    "PostgreSQL",
  ],
  knowsLanguage: ["es", "en"],
  sameAs: channels.map((c) => c.href),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <meta name="author" content="David Herrera" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    {!noindex && (
      <>
        <link rel="canonical" href={canonicalURL} />

        <link rel="alternate" hreflang="es" href={esURL} />
        <link rel="alternate" hreflang="en" href={enURL} />
        <link rel="alternate" hreflang="x-default" href={esURL} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="David Herrera" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="David Herrera" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="David Herrera" />
    <meta name="twitter:creator" content="@david_heca_" />
    <meta name="twitter:site" content="@david_heca_" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />

    <title>{tabTitle}</title>

    <!-- `.reveal` solo se esconde bajo `.js`: sin JS el contenido se ve entero. -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- En Safari el barrido circular del cambio de tema no funciona, así que se
         desactivan las View Transitions y el tema cambia en seco. `ThemeToggle`
         hace lo mismo en móvil, donde el efecto tampoco aporta. -->
    <script is:inline>
      if (
        typeof navigator !== "undefined" &&
        /^((?!chrome|android|crios|fxios).)*safari/i.test(navigator.userAgent)
      ) {
        document.startViewTransition = undefined;
      }
    </script>

    <ClientRouter />

    <script is:inline>
      function setThemeOnNavigation() {
        const themePreference = localStorage.getItem("color-theme") || "system";
        const resolvedTheme =
          themePreference === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : themePreference;

        if (resolvedTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }

        document.documentElement.dataset.themePref = themePreference;
      }

      document.addEventListener("astro:before-swap", (e) => {
        const currentTheme =
          document.documentElement.classList.contains("dark");
        if (currentTheme) {
          e.newDocument.documentElement.classList.add("dark");
        }
        // Los scripts inline de <head> no se reejecutan al hacer swap.
        e.newDocument.documentElement.classList.add("js");
        e.newDocument.documentElement.dataset.themePref =
          document.documentElement.dataset.themePref || "system";
      });

      document.addEventListener("astro:after-swap", setThemeOnNavigation);

      if (!window.__themeMediaListener) {
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const handler = () => {
          const preference = localStorage.getItem("color-theme");
          if (preference === "system" || !preference) {
            setThemeOnNavigation();
          }
        };

        if (media.addEventListener) {
          media.addEventListener("change", handler);
        }

        window.__themeMediaListener = true;
      }

      setThemeOnNavigation();
    </script>

    <!-- Redirige solo con preferencia explícita: autodetectar aquí sacaría a los
         rastreadores de "/", que es el canonical y el x-default. Las dos rutas
         llegan resueltas para no reimplementar el mapeo es↔en en el cliente.
         Fuera del índice no corre: convertiría el 404 en un 200 en otra URL. -->
    {!noindex && (
      <script is:inline define:vars={{ lang, esPath, enPath }}>
        var stored = localStorage.getItem("preferred-lang");
        if ((stored === "es" || stored === "en") && stored !== lang) {
          window.location.replace(stored === "es" ? esPath : enPath);
        }
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t("common.skipToContent")}</a>

    <Navbar lang={lang} switchTo={switchTo} />

    <main id="main" class="page">
      <slot />
    </main>

    <!-- Fuera de <main>: dentro no cuenta como landmark `contentinfo`. -->
    <slot name="footer" />

    <LanguageHint lang={lang} href={switchTo} />

    <script>
      // Sin desconectar el anterior se acumulan observers sobre nodos desmontados.
      let revealObserver: IntersectionObserver | undefined;

      function setupRevealAnimations() {
        revealObserver?.disconnect();
        revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("visible");
              revealObserver?.unobserve(entry.target);
            }
          },
          { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
        );

        document.querySelectorAll(".reveal").forEach((el) => revealObserver!.observe(el));
      }

      /** Las secciones se enlazan con anclas -sin JS, y para un rastreador, tienen
       *  que serlo-, pero al pulsarlas el fragmento no llega a la URL. Un destino en
       *  otra página no se toca: navega con fragmento y se limpia al aterrizar. */
      function sectionFor(link: HTMLAnchorElement): HTMLElement | null {
        const url = new URL(link.href);
        if (url.origin !== location.origin) return null;
        if (url.pathname !== location.pathname || url.search !== location.search) return null;
        const id = decodeURIComponent(url.hash.slice(1));
        return id ? document.getElementById(id) : null;
      }

      function goToSection(section: HTMLElement) {
        // Sin opciones: el suavizado y el offset bajo el navbar salen de `global.css`.
        section.scrollIntoView();
        // El foco lo movía el fragmento; sin reponerlo, teclado y lector de pantalla
        // se quedan al principio de la página.
        section.setAttribute("tabindex", "-1");
        section.focus({ preventScroll: true });
      }

      // Sobre `document`, así que se registra una sola vez por sesión. La captura no
      // es opcional: el ClientRouter escucha el mismo clic en burbujeo y solo se
      // aparta si le llega ya con `preventDefault`.
      document.addEventListener(
        "click",
        (e) => {
          if (e.defaultPrevented || e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
          const link = (e.target as Element | null)?.closest?.("a");
          if (!(link instanceof HTMLAnchorElement)) return;
          if (link.hasAttribute("download") || (link.target && link.target !== "_self")) return;
          const section = sectionFor(link);
          if (!section) return;
          e.preventDefault();
          goToSection(section);
        },
        { capture: true },
      );

      /** Un enlace compartido sí trae fragmento, y una navegación entre páginas lo
       *  arrastra. El salto va instantáneo porque se llega ya colocado, y
       *  `history.state` se reescribe tal cual: el router guarda ahí el scroll. */
      function dropHash() {
        if (!location.hash) return;
        document
          .getElementById(decodeURIComponent(location.hash.slice(1)))
          ?.scrollIntoView({ behavior: "instant" });
        history.replaceState(history.state, "", location.pathname + location.search);
      }

      setupRevealAnimations();
      dropHash();
      document.addEventListener("astro:page-load", () => {
        setupRevealAnimations();
        dropHash();
      });
    </script>
  </body>
</html>
