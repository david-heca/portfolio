---
import { ClientRouter } from "astro:transitions";
import Navbar from "@ui/Navbar.astro";
import LanguageHint from "@ui/LanguageHint.astro";
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "@fontsource/hanken-grotesk/latin-400.css";
import "@fontsource/hanken-grotesk/latin-500.css";
import "@fontsource/hanken-grotesk/latin-600.css";
import "@fontsource/hanken-grotesk/latin-700.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@styles/global.css";

export interface Props {
  title: string;
  description: string;
  lang?: "es" | "en";
  /** Solo para <title>; og:/twitter: siguen usando `title`. */
  tabTitle?: string;
}

const { title, description, lang = "es", tabTitle = title } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/assets/dh.webp", Astro.site);

const pathname = Astro.url.pathname;
const esPath = lang === "en"
  ? (pathname === "/en" || pathname === "/en/" ? "/" : pathname.replace(/^\/en\//, "/"))
  : pathname;
// Con barra: sin ella el hreflang no casa con el canonical y Google lo descarta.
const enPath = lang === "es"
  ? (pathname === "/" ? "/en/" : `/en${pathname}`)
  : pathname;
const esURL = new URL(esPath, Astro.site);
const enURL = new URL(enPath, Astro.site);

const ogLocale = lang === "es" ? "es_MX" : "en_US";
const ogLocaleAlt = lang === "es" ? "en_US" : "es_MX";

const cvEsURL = new URL("/assets/documents/davidherrera-spanish.pdf", Astro.site);
const cvEnURL = new URL("/assets/documents/davidherrera-english.pdf", Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "David Herrera",
  alternateName: "David Herrera del Castillo",
  url: Astro.site?.toString().replace(/\/$/, ""),
  image: socialImageURL.toString(),
  jobTitle: "Applied AI Engineer",
  description: description,
  worksFor: {
    "@type": "Organization",
    name: "Hypertech",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Mexico City",
    addressCountry: "MX",
  },
  email: "mailto:hello@davidherrera.dev",
  knowsAbout: [
    "Software Engineering",
    "Artificial Intelligence",
    "Large Language Models",
    "Retrieval-Augmented Generation",
    "Model Context Protocol",
    "MLOps",
    ".NET",
    "Python",
    "TypeScript",
    "React",
    "Azure",
    "PostgreSQL",
  ],
  knowsLanguage: ["es", "en"],
  sameAs: [
    "https://www.linkedin.com/in/david-heca/",
    "https://github.com/david-heca",
    "https://x.com/david_heca_",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <meta name="author" content="David Herrera" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#f5f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0d0b" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <!-- Sin hreflang: cada valor admite una sola URL y competían con el par de arriba. -->
    <link rel="alternate" type="application/pdf" href={cvEsURL} title="Currículum (ES)" />
    <link rel="alternate" type="application/pdf" href={cvEnURL} title="Resume (EN)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="David Herrera" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="David Herrera" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="David Herrera" />
    <meta name="twitter:creator" content="@david_heca_" />
    <meta name="twitter:site" content="@david_heca_" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />

    <title>{tabTitle}</title>

    <!-- `.reveal` solo se esconde bajo `.js`: sin JS el contenido se ve entero. -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <script is:inline>
      if (
        typeof navigator !== "undefined" &&
        /^((?!chrome|android|crios|fxios).)*safari/i.test(navigator.userAgent)
      ) {
        document.startViewTransition = undefined;
      }
    </script>

    <ClientRouter />

    <script is:inline>
      function setThemeOnNavigation() {
        const themePreference = localStorage.getItem("color-theme") || "system";
        const resolvedTheme =
          themePreference === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : themePreference;

        if (resolvedTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }

        document.documentElement.dataset.themePref = themePreference;
      }

      document.addEventListener("astro:before-swap", (e) => {
        const currentTheme =
          document.documentElement.classList.contains("dark");
        if (currentTheme) {
          e.newDocument.documentElement.classList.add("dark");
        }
        // Los scripts inline de <head> no se reejecutan al hacer swap.
        e.newDocument.documentElement.classList.add("js");
        e.newDocument.documentElement.dataset.themePref =
          document.documentElement.dataset.themePref || "system";
      });

      document.addEventListener("astro:after-swap", setThemeOnNavigation);

      if (!window.__themeMediaListener) {
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const handler = () => {
          const preference = localStorage.getItem("color-theme");
          if (preference === "system" || !preference) {
            setThemeOnNavigation();
          }
        };

        if (media.addEventListener) {
          media.addEventListener("change", handler);
        }

        window.__themeMediaListener = true;
      }

      setThemeOnNavigation();
    </script>

    <!-- Solo con preferencia elegida a mano. Autodetectar aquí rebotaba a los
         rastreadores fuera de "/", que es el canonical y el x-default; para eso
         está LanguageHint, que propone el cambio en vez de forzarlo. -->
    <script is:inline>
      (function() {
        var stored = localStorage.getItem("preferred-lang");
        if (stored !== "es" && stored !== "en") return;

        var path = window.location.pathname;
        var currentLang = (path === "/en" || path.startsWith("/en/")) ? "en" : "es";
        if (stored === currentLang) return;

        var target = stored === "en"
          ? (path === "/" ? "/en/" : "/en" + path)
          : (path === "/en" || path === "/en/" ? "/" : path.replace(/^\/en\//, "/") || "/");

        window.location.replace(target);
      })();
    </script>
  </head>
  <body>
    <Navbar transition:persist="navbar" />

    <main class="page">
      <slot />
    </main>

    <!-- Fuera de <main>: dentro no cuenta como landmark `contentinfo`. -->
    <slot name="footer" />

    <LanguageHint />

    <script>
      function setupRevealAnimations() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
        );

        document.querySelectorAll(".reveal").forEach((el) => {
          observer.observe(el);
        });
      }

      setupRevealAnimations();
      document.addEventListener("astro:page-load", setupRevealAnimations);
    </script>
  </body>
</html>
