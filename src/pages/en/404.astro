---
import Layout from "@layouts/Layout.astro";
import NotFound from "@sections/NotFound.astro";
import SiteFooter from "@ui/SiteFooter.astro";
import { useTranslations } from "@i18n/utils";

// Cloudflare sirve el `404.html` más cercano al path pedido: este cubre `/en/*`.
const lang = "en" as const;
const t = useTranslations(lang);
---

<Layout
  title={`${t("notFound.heading")} — ${t("notFound.title")}`}
  description={t("notFound.description")}
  lang={lang}
  noindex
>
  <NotFound lang={lang} />
  <SiteFooter slot="footer" />
</Layout>
