---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { useTranslations } from "@i18n/utils";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const venues = t<string[]>("speaking.venues");
const topics = t<string[]>("speaking.topics");
---

<section id="speaking" class="speaking section container">
  <div class="speaking__top reveal">
    <header class="sec-head speaking__intro">
      <p class="kicker">{t("speaking.label")}</p>
      <h2 class="section-title">{t("speaking.title")} <em>{t("speaking.titleItalic")}</em></h2>
      <p class="lead">{t("speaking.description")}</p>
    </header>
    <div class="speaking__stat">
      <p class="section-title speaking__figure">{t("speaking.attendees")}</p>
      <p class="label speaking__figure-label">{t("speaking.attendeesLabel")}</p>
    </div>
  </div>

  <figure class="speaking__media reveal reveal-1">
    <Image
      src="/assets/speaking.webp"
      alt={t("speaking.photoAlt")}
      width={889}
      height={1185}
      loading="lazy"
      quality={80}
    />
    <ul class="speaking__venues" aria-label={t("speaking.venuesLabel")}>
      {venues.map((v) => (
        <li class="label speaking__venue"><Icon name="ph:map-pin-duotone" />{v}</li>
      ))}
    </ul>
  </figure>

  <div class="speaking__topics reveal reveal-2">
    <p class="label">{t("speaking.topicsLabel")}</p>
    <div class="tag-row">{topics.map((tp) => <span class="tag">{tp}</span>)}</div>
  </div>
</section>

<style>
  .speaking__top { display: grid; gap: 32px; align-items: end; }
  @media (min-width: 900px) {
    .speaking__top { grid-template-columns: minmax(0, 1fr) 300px; gap: 56px; }
    .speaking__stat { text-align: right; }
  }

  .speaking__intro { margin-bottom: 0; }

  .speaking__figure {
    --display-size: var(--display-lg);
    --display-leading: 0.9;
    margin: 0;
    color: var(--color-accent);
  }
  .speaking__figure-label { margin-top: 8px; }

  .speaking__media {
    position: relative;
    margin-top: 44px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-bg-2);
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 768px) { .speaking__media { aspect-ratio: 21 / 8; } }
  /* El original es vertical y el marco apaisado se come casi todo: el encuadre
     se ancla arriba para que el recorte caiga sobre la cara, no sobre el torso. */
  .speaking__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .speaking__venues {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    padding: 20px 24px;
    background: linear-gradient(to top, var(--color-scrim), transparent);
  }
  .speaking__venue { display: inline-flex; align-items: center; gap: 8px; color: var(--color-on-scrim); }
  .speaking__venue [data-icon] { font-size: var(--icon-sm); }

  .speaking__topics {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 24px;
  }
</style>
