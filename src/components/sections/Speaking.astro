---
import { useTranslations, type Lang } from "@i18n/utils";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="speaking" class="section container">
  <h2 class="section-title">{t("speaking.title")}</h2>
  <p class="prose">{t("speaking.text")}</p>
</section>
