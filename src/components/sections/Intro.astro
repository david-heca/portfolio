---
import { Image } from "astro:assets";
import { useTranslations, type Lang } from "@i18n/utils";
import { Icon } from "astro-icon/components";
import photo from "@/assets/profile-photo.webp";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section container">
  <div class="intro__who">
    <div class="thumb intro__photo">
      <Image src={photo} alt="David Herrera" width={192} height={192} loading="eager" />
    </div>
    <div>
      <h1 class="page-title">David Herrera</h1>
      <p class="meta intro__role">
        <span class="intro__fact">
          <Icon name="ph:cpu" aria-hidden="true" />
          {t("intro.role")}
        </span>
        <span class="intro__fact">
          <Icon name="ph:map-pin" aria-hidden="true" />
          {t("intro.location")}
        </span>
      </p>
    </div>
  </div>

  <div class="intro__text">
    <p class="lead">{t("intro.lead")}</p>
    <p class="prose" set:html={t("intro.bio.paragraph1")}></p>
    <p class="prose" set:html={t("intro.bio.paragraph2")}></p>
  </div>
</section>

<style>
  .intro__who { display: flex; align-items: center; gap: var(--gap-row); }
  /* Cuerpo entero, sin recorte: a 64px no se leería. */
  .intro__photo { --thumb: 96px; }
  .intro__role { margin-top: 4px; display: flex; flex-wrap: wrap; column-gap: 16px; row-gap: 4px; }
  .intro__fact { display: inline-flex; align-items: center; gap: var(--gap-glyph); }
  .intro__fact [data-icon] { font-size: var(--icon-sm); flex-shrink: 0; }

  .intro__text { margin-top: 32px; display: flex; flex-direction: column; gap: 16px; }
</style>
