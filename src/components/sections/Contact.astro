---
import { useTranslations } from "@i18n/utils";
import { Icon } from "astro-icon/components";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const email = "hello@davidherrera.dev";
---

<section id="contact" class="contact section container">
  <div class="contact__intro reveal">
    <h2 class="section-title contact__title">{t("contact.headerTitle")}</h2>
    <p class="lead contact__lead">{t("contact.description")}</p>

    <div class="contact__cta">
      <a href={`mailto:${email}`} class="btn btn--primary">
        <Icon name="ph:paper-plane-tilt" />
        {t("contact.cta.button")}
      </a>
    </div>

    <p class="meta contact__note">{t("contact.cta.note")}</p>
  </div>
</section>

<style>
  .contact__title { --display-size: var(--display-lg); --display-leading: 0.98; }
  .contact__lead { margin-top: 20px; }
  .contact__cta { margin-top: 32px; }
  .contact__note { margin: 16px 0 0; }
</style>
