---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { useTranslations, type Lang } from "@i18n/utils";
import { projects } from "@/data/projects";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = projects.map((p) => ({
  ...p,
  title: t(`projects.list.${p.slug}.title`),
  desc: t(`projects.list.${p.slug}.description`),
}));
---

<section id="projects" class="section container">
  <h2 class="section-title">{t("projects.title")}</h2>

  <ol class="projects">
    {items.map((p) => (
      <li class="project">
        <div class="thumb">
          <Image src={p.image} alt="" width={128} height={128} loading="lazy" />
        </div>

        <div class="project__body">
          <div class="project__head">
            <h3 class="card-title">
              {p.href ? (
                <a href={p.href} target="_blank" rel="noopener noreferrer" class="card-link project__link">
                  {p.title}<Icon name="ph:arrow-up-right" aria-hidden="true" />
                </a>
              ) : (
                p.title
              )}
            </h3>
            <span class="rail">{p.year}</span>
          </div>
          <p class="prose-sm project__desc">{p.desc}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .projects { display: flex; flex-direction: column; }

  .project {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-row);
    padding-block: 20px;
  }
  .project + .project { border-top: 1px solid var(--color-line); }
  .project:first-child { padding-top: 0; }
  .project:last-child { padding-bottom: 0; }

  .project__body { flex: 1; min-width: 0; }

  .project__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .project__desc { margin-top: 4px; }

  .project__link:hover [data-icon],
  .project__link:focus-visible [data-icon] { transform: translate(2px, -2px); }
</style>
