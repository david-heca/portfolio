---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { useTranslations } from "@i18n/utils";
import { projects } from "@/data/projects";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = projects.map((p) => ({
  ...p,
  title: t(`projects.list.${p.slug}.title`),
  desc: t(`projects.list.${p.slug}.description`),
  statusLabel: t(`projects.status.${p.status}`),
  href: p.link.kind === "private" ? undefined : p.link.href,
  linkLabel: t(`projects.link.${p.link.kind}`),
}));
---

<section id="projects" class="projects section container">
  <header class="sec-head reveal">
    <p class="kicker">{t("nav.projects")}</p>
    <h2 class="section-title">{t("projects.headerTitle")} <em>{t("projects.headerItalic")}</em></h2>
    <p class="lead">{t("projects.description")}</p>
  </header>

  <div class="index">
    {items.map((p, i) => (
      <article class={`row reveal reveal-${Math.min(i + 1, 3)}`}>
        <div class="row__aside">
          <span class="rail">{p.year}</span>
          <span class="status"><span class="dot"></span>{p.statusLabel}</span>
        </div>

        <div class="row__main">
          <h3 class="card-title row__title">
            {p.href ? (
              <a href={p.href} target="_blank" rel="noopener noreferrer">
                {p.title}<span class="row__arrow" aria-hidden="true"><Icon name="ph:arrow-up-right" /></span>
              </a>
            ) : (
              p.title
            )}
          </h3>
          <p class="prose-sm row__desc">{p.desc}</p>

          <div class="tag-row row__foot">
            {p.tags.map((tag) => <span class="tag">{tag}</span>)}
            {p.href ? (
              <a class="tag tag--key row__link" href={p.href} target="_blank" rel="noopener noreferrer">
                {p.linkLabel}<Icon name="ph:arrow-up-right" aria-hidden="true" />
              </a>
            ) : (
              <span class="tag tag--muted">{p.linkLabel}</span>
            )}
          </div>
        </div>

        <div class="row__thumb">
          <Image src={p.image} alt={p.title} width={520} height={358} loading="lazy" quality={80} />
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .index { display: flex; flex-direction: column; }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    padding-block: 34px;
    border-top: 1px solid var(--color-line);
  }
  .row:last-child { border-bottom: 1px solid var(--color-line); }
  @media (min-width: 900px) {
    .row {
      grid-template-columns: 170px minmax(0, 1fr) 190px;
      gap: 32px;
      align-items: start;
    }
  }

  .row__aside { display: flex; flex-direction: column; gap: 9px; }
  .row__title a {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    transition: color var(--t-base) ease;
  }
  .row__title a:hover { color: var(--color-accent); }
  .row__arrow { display: inline-flex; font-size: 0.62em; color: var(--color-accent); }

  .row__desc { margin: 8px 0 0; max-width: var(--measure); }

  .row__foot { align-items: center; margin-top: 20px; }
  .row__link { gap: 7px; }
  .row__link [data-icon] { font-size: var(--icon-sm); }

  .row__thumb {
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-bg-2);
    aspect-ratio: 16 / 11;
    max-width: 240px;
  }
  .row__thumb img { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 900px) { .row__thumb { max-width: none; } }
</style>
