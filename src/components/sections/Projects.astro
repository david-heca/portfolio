---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { useTranslations, type Lang } from "@i18n/utils";
import { projects } from "@/data/projects";

export interface Props {
  lang: Lang;
}

interface Spec {
  label: string;
  value: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = projects.map((p) => ({
  ...p,
  title: t(`projects.list.${p.slug}.title`),
  desc: t(`projects.list.${p.slug}.description`),
  specs: t<Spec[]>(`projects.list.${p.slug}.specs`),
  statusLabel: t(`projects.status.${p.status}`),
  href: p.link.kind === "private" ? undefined : p.link.href,
  linkLabel: t(`projects.link.${p.link.kind}`),
}));

const years = projects.map((p) => Number(p.year));
const span = [...new Set([Math.min(...years), Math.max(...years)])].join(" - ");
const summary = `${projects.length} ${t("projects.countLabel")} · ${span}`;
---

<section id="projects" class="projects section container">
  <header class="projects__head reveal">
    <h2 class="section-title">{t("projects.headerTitle")}</h2>
    <p class="label projects__summary">{summary}</p>
  </header>
  <p class="lead projects__lead reveal">{t("projects.description")}</p>

  <ol class="projects__list">
    {items.map((p, i) => (
      <li class:list={["project", "reveal", `reveal-${Math.min(i + 1, 3)}`, i % 2 === 1 && "project--flip"]}>
        <div class="project__body">
          <div class="project__head">
            <h3 class="card-title project__title">{p.title}</h3>
            <span class="status"><span class="dot"></span>{p.statusLabel}</span>
          </div>
          <p class="prose project__desc">{p.desc}</p>
          <div class="tag-row project__tags">
            {p.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </div>

        <div class="project__media">
          <div class="project__frame">
            <Image src={p.image} alt={p.title} width={800} height={600} loading="lazy" quality={80} />
          </div>
          <dl class="spec">
            {p.specs.map((s) => (
              <>
                <dt class="label">{s.label}</dt>
                <dd class="label spec__value">{s.value}</dd>
              </>
            ))}
            <dt class="label">{t("projects.specLink")}</dt>
            <dd class="label spec__link">
              {p.href ? (
                <a href={p.href} target="_blank" rel="noopener noreferrer">
                  {p.linkLabel}<Icon name="ph:arrow-up-right" aria-hidden="true" />
                </a>
              ) : (
                p.linkLabel
              )}
            </dd>
          </dl>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .projects__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-line);
  }
  /* Alineación óptica: sube la etiqueta hasta la línea base de la display, que
     apoya por encima del borde de su caja. Fuera de rejilla a propósito. */
  .projects__summary { padding-bottom: 6px; }

  .projects__lead { margin-top: 24px; max-width: 46ch; }

  .projects__list { display: flex; flex-direction: column; gap: 72px; margin-top: 72px; }

  .project { display: grid; gap: 24px; }
  @media (min-width: 900px) {
    .project {
      grid-template-columns: minmax(0, 1fr) 36%;
      gap: 40px;
      align-items: center;
    }
    .project--flip { grid-template-columns: 36% minmax(0, 1fr); }
    .project--flip .project__media { order: -1; }
    .project--flip .project__body { text-align: right; }
    .project--flip .project__head { flex-direction: row-reverse; }
    .project--flip .project__desc { margin-inline: auto 0; }
    .project--flip .project__tags { justify-content: flex-end; }
    .projects__list { gap: 88px; }
  }

  .project__head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .project__title { font-size: var(--text-subhead); }
  .project__desc { margin-top: 12px; max-width: 46ch; }
  .project__tags { margin-top: 20px; }

  .project__media { position: relative; }
  .project__frame {
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-bg-2);
    aspect-ratio: 4 / 3;
  }
  .project__frame img { width: 100%; height: 100%; object-fit: cover; }

  .spec {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 16px;
    margin-top: 16px;
  }
  .spec dd { text-align: right; }
  .spec dt,
  .spec dd {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-line);
  }
  .spec > :nth-last-child(-n + 2) { padding-bottom: 0; border-bottom: 0; }
  .spec__value { color: var(--color-ink); }
  .spec__link a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent);
  }
  .spec__link [data-icon] { font-size: var(--icon-sm); }

  /* En táctil la ficha se lee bajo la imagen; con puntero se superpone, y por eso
     usa el par de scrim: debajo está la foto, no el fondo de la página. */
  @media (hover: hover) {
    .spec {
      position: absolute;
      inset: 0;
      align-content: end;
      margin-top: 0;
      padding: 22px;
      border-radius: var(--radius-sm);
      background: var(--color-scrim);
      opacity: 0;
      transition: opacity var(--t-base) ease;
    }
    .spec dt,
    .spec dd { border-bottom-color: color-mix(in srgb, var(--color-on-scrim) 24%, transparent); }
    .spec .label { color: color-mix(in srgb, var(--color-on-scrim) 72%, transparent); }
    .spec__value,
    .spec__link a { color: var(--color-on-scrim); }
    .project__media:hover .spec,
    .project__media:focus-within .spec { opacity: 1; }
  }
</style>
