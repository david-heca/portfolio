---
import { channels } from "@/data/contact";
import { useTranslations, type Lang } from "@i18n/utils";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="top" class="hero container">
  <div class="hero__text">
    <p class="section-title hero__thesis reveal">{t("hero.thesis")}</p>

    <p class="lead hero__intro reveal reveal-1">{t("hero.intro")}</p>

    <div class="hero__who reveal reveal-2">
      <h1 class="hero__name">David Herrera</h1>
      <span class="hero__sep" aria-hidden="true">·</span>
      <p class="hero__role">{t("hero.role")}</p>
    </div>

    <div class="hero__actions reveal reveal-3">
      <a href="#projects" class="btn btn--primary">
        <Icon name="ph:squares-four" aria-hidden="true" />
        {t("hero.ctaProjects")}
      </a>
      <a href="#contact" class="btn btn--ghost">
        <Icon name="ph:paper-plane-tilt" aria-hidden="true" />
        {t("hero.ctaContact")}
      </a>
    </div>
  </div>

  <div class="hero__photo reveal reveal-1">
    <Image
      src="/assets/profile-photo.webp"
      alt="David Herrera"
      width={440}
      height={560}
      loading="eager"
      format="webp"
      quality={85}
    />
    <div class="hero__socials">
      {channels.map((c) => (
        <a href={c.href} target="_blank" rel="noopener noreferrer">
          <Icon name={c.icon} aria-hidden="true" />
          <span class="sr-only">{t(`common.channels.${c.key}`)}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 1.35fr 1fr; gap: 64px; }
  }

  .hero__thesis {
    --display-size: var(--display-lg);
    --display-leading: 1;
    max-width: 15ch;
  }

  .hero__intro { margin-top: 24px; }

  .hero__who {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: 28px;
    font-size: var(--text-body);
    line-height: var(--leading-snug);
  }
  .hero__name { font-weight: var(--weight-medium); color: var(--color-ink); }
  .hero__sep { color: var(--color-ink-3); }
  .hero__role { color: var(--color-ink-2); }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero__photo { position: relative; max-width: 440px; justify-self: center; }
  .hero__photo img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line);
  }

  /* Va sobre la foto, no sobre el fondo de la página: usa el par de scrim, que no
     cambia con el tema. */
  .hero__socials {
    position: absolute;
    bottom: 16px;
    left: 16px;
    display: inline-flex;
    gap: 8px;
    padding: 7px 10px;
    border-radius: var(--radius-control);
    background: var(--color-scrim);
  }
  .hero__socials a {
    display: inline-flex;
    color: color-mix(in srgb, var(--color-on-scrim) 78%, transparent);
    transition: color var(--t-fast) ease, transform var(--t-fast) ease;
  }
  .hero__socials a:hover { color: var(--color-on-scrim); transform: translateY(-2px); }
  .hero__socials [data-icon] { font-size: var(--icon-lg); }
</style>
