---
import { useTranslations } from "@i18n/utils";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="top" class="hero container">
  <div class="hero__text">
    <p class="hero__place reveal">
      <Icon name="ph:map-pin" />
      {t("hero.location")}
    </p>

    {/* Lo más grande de la página es la afirmación, no el nombre. El `h1` sigue
        siendo el nombre porque es de quien va la página: el nivel de encabezado
        y el cuerpo de letra responden a preguntas distintas. */}
    <p class="section-title hero__thesis reveal reveal-1">{t("hero.thesis")}</p>

    <p class="lead hero__intro reveal reveal-2">{t("hero.intro")}</p>

    <div class="hero__who reveal reveal-2">
      <h1 class="hero__name">David Herrera</h1>
      <span class="hero__sep" aria-hidden="true">·</span>
      <p class="hero__role">{t("hero.role")}</p>
    </div>

    <div class="hero__actions reveal reveal-3">
      <a href="#projects" class="btn btn--primary">{t("hero.ctaProjects")}</a>
      <a href="#contact" class="btn btn--ghost">{t("hero.ctaContact")}</a>
    </div>
  </div>

  <div class="hero__photo reveal reveal-1">
    <Image
      src="/assets/profile-photo.webp"
      alt="David Herrera"
      width={440}
      height={560}
      loading="eager"
      format="webp"
      quality={85}
    />
    <div class="hero__socials">
      <a href="https://github.com/david-heca" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="ph:github-logo" /></a>
      <a href="https://www.linkedin.com/in/david-heca/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="ph:linkedin-logo" /></a>
      <a href="https://x.com/david_heca_" target="_blank" rel="noopener noreferrer" aria-label="X"><Icon name="ph:x-logo" /></a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 1.35fr 1fr; gap: 64px; }
  }

  /* Única etiqueta en versalitas que queda en el sitio. Sobre los títulos de
     sección se quitó: ahí era un adorno editorial; aquí es un dato. */
  .hero__place {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--color-ink-2);
  }
  .hero__place [data-icon] { font-size: var(--icon-sm); color: var(--color-ink-3); }

  .hero__thesis {
    --display-size: var(--display-lg);
    --display-leading: 1;
    margin-top: 24px;
    max-width: 15ch;
  }

  .hero__intro { margin-top: 24px; }

  .hero__who {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: 28px;
    font-size: var(--text-body);
    line-height: var(--leading-snug);
  }
  .hero__name { font-weight: var(--weight-medium); color: var(--color-ink); }
  .hero__sep { color: var(--color-ink-3); }
  .hero__role { color: var(--color-ink-2); }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero__photo { position: relative; max-width: 440px; justify-self: center; }
  .hero__photo img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line);
  }

  /* Va sobre la foto, no sobre el fondo de la página: usa el par de scrim, que no
     cambia con el tema. */
  .hero__socials {
    position: absolute;
    bottom: 16px;
    left: 16px;
    display: inline-flex;
    gap: 8px;
    padding: 7px 10px;
    border-radius: var(--radius-control);
    background: var(--color-scrim);
  }
  .hero__socials a {
    display: inline-flex;
    color: color-mix(in srgb, var(--color-on-scrim) 78%, transparent);
    transition: color var(--t-fast) ease, transform var(--t-fast) ease;
  }
  .hero__socials a:hover { color: var(--color-on-scrim); transform: translateY(-2px); }
  .hero__socials [data-icon] { font-size: var(--icon-lg); }
</style>
