---
import { useTranslations } from "@i18n/utils";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="top" class="hero container">
  <div class="hero__text">
    <p class="hero__place reveal">
      <Icon name="ph:map-pin-duotone" />
      {t("hero.location")}
    </p>

    <h1 class="section-title hero__name reveal reveal-1">David Herrera</h1>

    <p class="hero__role reveal reveal-1">{t("hero.role")}</p>

    <p class="lead hero__intro reveal reveal-2">{t("hero.intro")}</p>

    <div class="hero__actions reveal reveal-3">
      <a href="#projects" class="btn btn--primary"><Icon name="ph:squares-four-duotone" />{t("hero.ctaProjects")}</a>
      <a href="#contact" class="btn btn--ghost"><Icon name="ph:chat-circle-duotone" />{t("hero.ctaContact")}</a>
    </div>
  </div>

  <div class="hero__photo reveal reveal-1">
    <Image
      src="/assets/profile-photo.webp"
      alt="David Herrera"
      width={440}
      height={560}
      loading="eager"
      format="webp"
      quality={85}
    />
    <div class="hero__socials">
      <a href="https://github.com/david-heca" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="ph:github-logo-duotone" /></a>
      <a href="https://www.linkedin.com/in/david-heca/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="ph:linkedin-logo-duotone" /></a>
      <a href="https://x.com/david_heca_" target="_blank" rel="noopener noreferrer" aria-label="X"><Icon name="ph:x-logo-duotone" /></a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  @media (min-width: 900px) {
    .hero { grid-template-columns: 1.35fr 1fr; gap: 64px; }
  }

  .hero__place {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--color-ink-2);
  }
  .hero__place [data-icon] { font-size: 14px; color: var(--color-accent); }

  .hero__name { --display-size: clamp(56px, 11vw, 124px); --display-leading: 0.92; }

  .hero__role {
    font-family: var(--font-text);
    font-weight: 500;
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 20px 0 0;
  }

  .hero__intro { margin: 20px 0 0; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero__photo { position: relative; max-width: 440px; justify-self: center; }
  .hero__photo img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-line);
  }
  .hero__socials {
    position: absolute;
    bottom: 16px;
    left: 16px;
    display: inline-flex;
    gap: 6px;
    padding: 7px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-line);
  }
  .hero__socials a {
    display: inline-flex;
    color: var(--color-ink);
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .hero__socials a:hover { color: var(--color-accent); transform: translateY(-2px); }
  .hero__socials [data-icon] { font-size: 19px; }
</style>
