---
import { useTranslations, type Lang } from "@i18n/utils";
import { roles } from "@/data/work";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const ongoing = t("common.ongoing");

const items = roles.map((r) => ({
  period: `${r.from} - ${r.to ?? ongoing}`,
  current: r.to === undefined,
  title: t(`work.roles.${r.key}.title`),
  company: t(`work.companies.${r.company}`),
  summary: t(`work.roles.${r.key}.summary`),
}));
---

<section id="work" class="section container">
  <h2 class="section-title">{t("work.title")}</h2>

  <ol class="rows">
    {items.map((r) => (
      <li class="row">
        <span class:list={["rail", r.current && "rail--current"]}>{r.period}</span>
        <div>
          <h3 class="card-title">
            {r.title}<span class="role__company"> · {r.company}</span>
          </h3>
          <p class="prose-sm role__summary">{r.summary}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .role__company { color: var(--color-ink-2); }
  .role__summary { margin-top: 4px; }
</style>
