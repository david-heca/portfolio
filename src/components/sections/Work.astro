---
import { useTranslations, type Lang } from "@i18n/utils";
import { Icon } from "astro-icon/components";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface Role {
  title: string;
  period: string;
  type: string;
  achievements: string[];
  /** Opcional: un rol recién empezado todavía no tiene stack que enseñar. */
  stack?: string[];
  current?: boolean;
}
interface Company {
  name: string;
  span: string;
  loc?: string;
  mode?: string;
  roles: Role[];
}

const companies: Company[] = [
  {
    name: t("work.companies.hypertech.name"),
    span: t("work.companies.hypertech.totalPeriod"),
    loc: t("work.companies.hypertech.location"),
    mode: t("work.companies.hypertech.workMode"),
    roles: [
      {
        title: t("work.companies.hypertech.roles.appliedai.title"),
        period: t("work.companies.hypertech.roles.appliedai.period"),
        type: t("work.companies.hypertech.roles.appliedai.type"),
        achievements: t<string[]>("work.companies.hypertech.roles.appliedai.achievements"),
        current: true,
      },
    ],
  },
  {
    name: t("work.companies.baacc.name"),
    span: t("work.companies.baacc.totalPeriod"),
    loc: t("work.companies.baacc.location"),
    mode: t("work.companies.baacc.workMode"),
    roles: [
      {
        title: t("work.companies.baacc.roles.architect.title"),
        period: t("work.companies.baacc.roles.architect.period"),
        type: t("work.companies.baacc.roles.architect.type"),
        achievements: t<string[]>("work.companies.baacc.roles.architect.achievements"),
        stack: ["LLMs", "RAG", "MCP", "MLOps", "Azure"],
      },
      {
        title: t("work.companies.baacc.roles.fullstack.title"),
        period: t("work.companies.baacc.roles.fullstack.period"),
        type: t("work.companies.baacc.roles.fullstack.type"),
        achievements: t<string[]>("work.companies.baacc.roles.fullstack.achievements"),
        stack: [".NET", "Python", "SQL", "Android"],
      },
      {
        title: t("work.companies.baacc.roles.junior.title"),
        period: t("work.companies.baacc.roles.junior.period"),
        type: t("work.companies.baacc.roles.junior.type"),
        achievements: t<string[]>("work.companies.baacc.roles.junior.achievements"),
        stack: ["MVC", "SQL", "APIs"],
      },
    ],
  },
  {
    name: t("work.companies.dec.name"),
    span: t("work.companies.dec.totalPeriod"),
    loc: t("work.companies.dec.location"),
    mode: t("work.companies.dec.workMode"),
    roles: [
      {
        title: t("work.companies.dec.roles.webdev.title"),
        period: t("work.companies.dec.roles.webdev.period"),
        type: t("work.companies.dec.roles.webdev.type"),
        achievements: t<string[]>("work.companies.dec.roles.webdev.achievements"),
        stack: ["HTML", "CSS", "JavaScript", "WordPress"],
      },
    ],
  },
];
---

<section id="work" class="work section container">
  <header class="sec-head reveal">
    <h2 class="section-title">{t("work.headerTitle")}</h2>
    <p class="lead">{t("work.description")}</p>
  </header>

  <div class="work__list">
    {companies.map((co) => (
      <article class="work__company reveal">
        <div class="work__company-head">
          <h3 class="section-title work__company-name">{co.name}</h3>
          <span class="meta">{[co.span, co.loc, co.mode].filter(Boolean).join(" · ")}</span>
        </div>

        <div class="work__roles">
          {co.roles.map((r) => (
            <div class="role">
              <div class="role__aside">
                <span class="rail">{r.period}</span>
                {r.current && (
                  <span class="status"><span class="dot"></span>{t("work.current")}</span>
                )}
              </div>
              <div class="role__main">
                <h4 class="card-title">{r.title}</h4>
                <span class="label role__type">{r.type}</span>
                <ul class="prose-sm role__achievements">
                  <li>{r.achievements[0]}</li>
                </ul>
                {r.achievements.length > 1 && (
                  <details class="role__more">
                    <summary class="label role__more-toggle">
                      <span class="role__more-label role__more-label--more">
                        {t("work.showMore")} ({r.achievements.length - 1})
                      </span>
                      <span class="role__more-label role__more-label--less">{t("work.showLess")}</span>
                      <Icon name="ph:caret-down" class="role__more-caret" aria-hidden="true" />
                    </summary>
                    <ul class="prose-sm role__achievements role__achievements--extra">
                      {r.achievements.slice(1).map((a) => <li>{a}</li>)}
                    </ul>
                  </details>
                )}
                {r.stack && (
                  <div class="tag-row role__stack">
                    {r.stack.map((s) => <span class="tag">{s}</span>)}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .work__list { display: flex; flex-direction: column; gap: 56px; }

  .work__company-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding-bottom: 16px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--color-line);
  }
  .work__company-name { --display-size: var(--display-sm); margin: 0; }

  .work__roles { display: flex; flex-direction: column; gap: 36px; }

  .role {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .role { grid-template-columns: 170px 1fr; gap: 32px; }
  }
  .role__aside { display: flex; flex-direction: column; gap: 12px; }
  .role__type { display: inline-block; margin-top: 8px; }
  .role__achievements {
    margin: 16px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: var(--measure);
  }
  .role__achievements li { position: relative; padding-left: 24px; }
  .role__achievements li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 10px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-ink-3);
  }
  /* <details> nativo: el contenido plegado sigue en el DOM para Cmd+F y SEO. */
  .role__more { margin-top: 16px; }
  .role__more-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: color var(--t-fast) ease;
  }
  .role__more-toggle::-webkit-details-marker { display: none; }
  .role__more-toggle:hover { color: var(--color-accent); }
  .role__more-caret { font-size: var(--icon-sm); transition: transform var(--t-base) ease; }
  .role__more[open] .role__more-caret { transform: rotate(180deg); }
  .role__more-label--less { display: none; }
  .role__more[open] .role__more-label--more { display: none; }
  .role__more[open] .role__more-label--less { display: inline; }
  .role__achievements--extra { margin-top: 16px; }

  .role__stack { margin-top: 16px; }
</style>
