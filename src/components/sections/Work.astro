---
import { useTranslations, type Lang } from "@i18n/utils";
import { companies } from "@/data/work";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const ongoing = t("common.ongoing");

const span = (from: number, to?: number) => `${from} - ${to ?? ongoing}`;

const items = companies.map(({ key, roles }) => {
  const current = roles.some((r) => r.to === undefined);
  const first = roles[roles.length - 1];
  const last = roles[0];
  return {
    period: span(first.from, current ? undefined : last.to),
    current,
    name: t(`work.companies.${key}`),
    stages: roles.map((r) => ({
      title: t(`work.roles.${r.key}.title`),
      /* Con una sola etapa el raíl ya dice los años; repetirlos sobra. */
      period: roles.length > 1 ? span(r.from, r.to) : undefined,
      summary: t(`work.roles.${r.key}.summary`),
    })),
  };
});
---

<section id="work" class="section container">
  <h2 class="section-title">{t("work.title")}</h2>

  <ol class="rows">
    {items.map((c) => (
      <li class="row">
        <span class:list={["rail", c.current && "rail--current"]}>{c.period}</span>
        <div class:list={["thread", c.current && "thread--current"]}>
          <h3 class="card-title">{c.name}</h3>
          <ol class="stages">
            {c.stages.map((s) => (
              <li>
                <h4 class="card-title stage__title">
                  {s.title}{s.period && <span class="stage__period"> · {s.period}</span>}
                </h4>
                <p class="prose-sm stage__summary">{s.summary}</p>
              </li>
            ))}
          </ol>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  /* Un solo hilo vertical en vez de una raya por fila: cruza el hueco entre
     empresas y se corta en la última. */
  .thread { position: relative; padding-left: var(--gap-row); }
  .thread::before,
  .thread::after { content: ""; position: absolute; }
  .thread::before {
    left: calc(var(--thread-dot) / 2);
    top: 0;
    bottom: calc(-2 * var(--row-y));
    width: 1px;
    background: var(--color-line);
  }
  .row:last-child .thread::before { bottom: 0; }
  /* Alineación óptica: el nudo se centra en la primera línea del título. */
  .thread::after {
    left: 0;
    top: calc((1lh - var(--thread-dot)) / 2);
    width: var(--thread-dot);
    height: var(--thread-dot);
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-ink-2);
  }
  .thread--current::after {
    background: var(--color-accent);
    box-shadow: none;
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    from { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 60%, transparent); }
    to { box-shadow: 0 0 0 8px transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .thread--current::after { animation: none; }
  }

  .stages { margin-top: 8px; display: flex; flex-direction: column; gap: 16px; }
  .stage__title { font-weight: normal; }
  .stage__period { color: var(--color-ink-2); }
  .stage__summary { margin-top: 4px; }
</style>
