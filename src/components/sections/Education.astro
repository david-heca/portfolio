---
import { useTranslations } from "@i18n/utils";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface Entry {
  period: string;
  title: string;
  meta: string;
  note?: string;
  /** El nodo lleno en la línea marca lo que sigue en curso. */
  current?: boolean;
}

const academic: Entry[] = [
  { key: "tesco" },
  { key: "platzi", current: true },
  { key: "cecytem" },
].map(({ key, current }) => ({
  period: t(`education.list.${key}.period`),
  title: t(`education.list.${key}.degree`),
  meta: t(`education.list.${key}.institution`),
  note: t(`education.list.${key}.description`),
  current,
}));

const certs: Entry[] = [
  { period: "2024", title: t("education.certifications.azure.name"), meta: "Microsoft" },
  { period: "2022", title: t("education.certifications.python.name"), meta: "U. Michigan · Coursera" },
];

const groups = [
  { label: t("education.academicTitle"), entries: academic },
  { label: t("education.certsTitle"), entries: certs },
];
---

<section id="education" class="edu section container">
  <header class="sec-head reveal">
    <p class="kicker">{t("nav.education")}</p>
    <h2 class="section-title">{t("education.headerTitle")} <em>{t("education.headerItalic")}</em></h2>
    <p class="lead">{t("education.description")}</p>
  </header>

  <div class="edu__groups">
    {groups.map((g, i) => (
      <div class={`edu__group reveal reveal-${Math.min(i + 1, 3)}`}>
        <p class="kicker edu__label">{g.label}</p>
        <div class="edu__list">
          {g.entries.map((e) => (
            <div class:list={["edu-item", e.current && "edu-item--current"]}>
              <span class="rail edu-item__period">{e.period}</span>
              <div class="edu-item__body">
                <h3 class="card-title edu-item__title">{e.title}</h3>
                <p class="meta edu-item__meta">{e.meta}</p>
                {e.note && <p class="prose-sm edu-item__note">{e.note}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .edu__groups { display: flex; flex-direction: column; gap: 72px; }

  .edu__label { margin-bottom: 32px; }

  .edu__list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .edu-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding-left: 22px;
  }

  .edu__list::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--color-line-strong);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
  }

  .edu-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  .edu-item--current::before {
    background: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-soft);
  }

  @media (min-width: 768px) {
    .edu-item {
      grid-template-columns: 128px minmax(0, 660px);
      gap: 44px;
      padding-left: 0;
    }
    /* 128px de rail + medio gap: el hilo cae entre fecha y contenido. */
    .edu__list::before { left: 150px; }
    .edu-item::before { left: 147px; }
    .edu-item__period { text-align: right; }
  }

  .edu-item__period { padding-top: 7px; }
  .edu-item--current .edu-item__period { color: var(--color-accent); }

  .edu-item__title { text-wrap: balance; }
  .edu-item__meta { margin: 8px 0 0; }
  .edu-item__note { margin-top: 12px; }
</style>
