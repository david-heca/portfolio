---
import { useTranslations, type Lang } from "@i18n/utils";
import { studies } from "@/data/education";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const ongoing = t("common.ongoing");

const items = studies.map(({ key, from, to }) => ({
  period: `${from} - ${to ?? ongoing}`,
  current: to === undefined,
  title: t(`education.list.${key}.degree`),
  institution: t(`education.list.${key}.institution`),
}));
---

<section id="education" class="section container">
  <h2 class="section-title">{t("education.title")}</h2>

  <ul class="rows">
    {items.map((e) => (
      <li class="row">
        <span class:list={["rail", e.current && "rail--current"]}>{e.period}</span>
        <div>
          <h3 class="card-title">{e.title}</h3>
          <p class="prose-sm edu__institution">{e.institution}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .edu__institution { margin-top: 4px; }
</style>
