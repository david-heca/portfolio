---
import { useTranslations } from "@i18n/utils";

export interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface Entry {
  period: string;
  title: string;
  meta: string;
  note?: string;
  /** El nodo lleno en la línea marca lo que sigue en curso. */
  current?: boolean;
}

const academic: Entry[] = [
  { key: "tesco" },
  { key: "platzi", current: true },
  { key: "cecytem" },
].map(({ key, current }) => ({
  period: t(`education.list.${key}.period`),
  title: t(`education.list.${key}.degree`),
  meta: t(`education.list.${key}.institution`),
  note: t(`education.list.${key}.description`),
  current,
}));

const certs: Entry[] = [
  { period: "2024", title: t("education.certifications.azure.name"), meta: "Microsoft" },
  { period: "2022", title: t("education.certifications.python.name"), meta: "U. Michigan · Coursera" },
];

const groups = [
  { label: t("education.academicTitle"), entries: academic },
  { label: t("education.certsTitle"), entries: certs },
];
---

<section id="education" class="edu section container">
  <header class="sec-head reveal">
    <p class="kicker">{t("nav.education")}</p>
    <h2 class="section-title">{t("education.headerTitle")} <em>{t("education.headerItalic")}</em></h2>
    <p class="lead">{t("education.description")}</p>
  </header>

  <div class="edu__groups">
    {groups.map((g, i) => (
      <div class={`edu__group reveal reveal-${Math.min(i + 1, 3)}`}>
        <p class="edu__label">{g.label}</p>
        <div class="edu__list">
          {g.entries.map((e) => (
            <div class:list={["edu-item", e.current && "edu-item--current"]}>
              <span class="edu-item__period">{e.period}</span>
              <div class="edu-item__body">
                <h3 class="edu-item__title">{e.title}</h3>
                <p class="edu-item__meta">{e.meta}</p>
                {e.note && <p class="edu-item__note">{e.note}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .sec-head { max-width: 720px; margin-bottom: 56px; }
  .sec-head .lead { margin-top: 20px; }

  .edu__groups { display: flex; flex-direction: column; gap: 72px; }

  .edu__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 32px;
  }

  .edu__list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .edu-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding-left: 22px;
  }

  /* El hilo vertical es la cronología: sostiene la sección y marca dónde
     sigue abierta. Se desvanece en los extremos para no cortar en seco. */
  .edu__list::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--color-line-strong);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
  }

  .edu-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  .edu-item--current::before {
    background: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-soft);
  }

  @media (min-width: 768px) {
    .edu-item {
      grid-template-columns: 128px minmax(0, 660px);
      gap: 44px;
      padding-left: 0;
    }
    /* Rail de 128px + medio gap: el hilo cae justo entre fecha y contenido,
       y el cuerpo arranca en 172px, el mismo del rail de Work. */
    .edu__list::before { left: 150px; }
    .edu-item::before { left: 147px; }
    .edu-item__period { text-align: right; }
  }

  .edu-item__period {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
    padding-top: 7px;
  }
  .edu-item--current .edu-item__period { color: var(--color-accent); }

  .edu-item__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-card-title);
    line-height: 1.1;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }
  .edu-item__meta {
    font-size: var(--text-meta);
    color: var(--color-ink-2);
    margin: 8px 0 0;
  }
  .edu-item__note {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-ink-3);
    margin: 12px 0 0;
  }
</style>
