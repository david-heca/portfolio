---
import { Icon } from "astro-icon/components";
import { useTranslations, type Lang } from "@i18n/utils";
import { studies, certifications } from "@/data/education";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const ongoing = t("education.ongoing");

interface Row {
  period: string;
  title: string;
  meta: string;
  current?: boolean;
}

const academic: Row[] = studies.map(({ key, from, to }) => ({
  period: `${from} - ${to ?? ongoing}`,
  title: t(`education.list.${key}.degree`),
  meta: [t(`education.list.${key}.institution`), t(`education.list.${key}.description`)].join(" · "),
  current: to === undefined,
}));

const certs: Row[] = certifications.map(({ key, year }) => ({
  period: String(year),
  title: t(`education.certifications.${key}.name`),
  meta: t(`education.certifications.${key}.issuer`),
}));

const groups = [
  { label: t("education.academicTitle"), icon: "ph:graduation-cap", entries: academic },
  { label: t("education.certsTitle"), icon: "ph:certificate", entries: certs },
];
---

<section id="education" class="section container">
  <header class="sec-head">
    <h2 class="section-title">{t("education.headerTitle")}</h2>
    <p class="prose">{t("education.description")}</p>
  </header>

  <div class="edu">
    {groups.map((g) => (
      <div>
        <h3 class="label edu__label">
          <Icon name={g.icon} aria-hidden="true" />
          {g.label}
        </h3>
        <ul class="rows">
          {g.entries.map((e) => (
            <li class="row">
              <span class:list={["rail", e.current && "edu__current"]}>{e.period}</span>
              <div>
                <h4 class="card-title">{e.title}</h4>
                <p class="meta edu__meta">{e.meta}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .edu { display: flex; flex-direction: column; gap: 40px; }

  .edu__label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-line);
  }
  .edu__label [data-icon] { font-size: var(--icon); color: var(--color-ink-3); }

  /* Lo que sigue abierto sube a tinta: es el único dato vivo de la lista. */
  .edu__current { color: var(--color-ink); }
  .edu__meta { margin-top: 4px; }
</style>
