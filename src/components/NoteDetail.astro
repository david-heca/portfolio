---
import EnterWords from "@ui/EnterWords.astro";
import { Icon } from "astro-icon/components";
import { render, type CollectionEntry } from "astro:content";
import { localizePath, useTranslations, type Lang } from "@i18n/utils";

export interface Props {
  lang: Lang;
  entry: CollectionEntry<"notes">;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const index = localizePath("/notes/", lang);

const dateFormat = new Intl.DateTimeFormat(lang === "es" ? "es-MX" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="note-page section container">
  <a class="link link--back" href={index}>
    <Icon name="hugeicons:arrow-left-02" aria-hidden="true" />
    {t("notes.all")}
  </a>

  <header class="note-page__head">
    <h1 class="page-title"><EnterWords text={entry.data.title} /></h1>
    <p class="lead enter enter--lead note-page__summary">{entry.data.summary}</p>

    <p class="note-page__facts">
      <time class="rail" datetime={entry.data.date.toISOString()}>{dateFormat.format(entry.data.date)}</time>
      {entry.data.tags.map((tag) => <span class="rail note-page__tag">{tag}</span>)}
    </p>
  </header>

  <div class="longform note-page__body">
    <Content />
  </div>
</article>

<style>
  .note-page__head {
    margin-top: 24px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-line);
  }
  .note-page__summary { margin-top: 16px; }

  .note-page__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 16px;
  }
  .note-page__tag { white-space: nowrap; }

  .note-page__body { margin-top: 40px; }
</style>
