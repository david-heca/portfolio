---
import { Icon } from "astro-icon/components";
import type { LocalizedEntry } from "@/data/collections";
import { localizePath, type Lang } from "@i18n/utils";

export interface Props {
  lang: Lang;
  items: LocalizedEntry<"notes">[];
}

const { lang, items } = Astro.props;
const base = localizePath("/notes/", lang);

const dateFormat = new Intl.DateTimeFormat(lang === "es" ? "es-MX" : "en-US", {
  year: "numeric",
  month: "short",
});
---

<ul class="rows">
  {items.map(({ slug, entry }) => (
    <li class="row">
      <time class="rail" datetime={entry.data.date.toISOString()}>
        {dateFormat.format(entry.data.date)}
      </time>
      <a class="card-link note" href={`${base}${slug}/`}>
        <span class="card-title note__title">
          {entry.data.title}
          <Icon name="ph:arrow-right" aria-hidden="true" />
        </span>
        <span class="prose-sm note__summary">{entry.data.summary}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .note { display: block; }
  .note__title { display: block; }
  .note__summary { display: block; margin-top: 4px; }

  .note:hover [data-icon],
  .note:focus-visible [data-icon] { transform: translateX(4px); }
</style>
