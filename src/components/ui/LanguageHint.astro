---
import { getHome, useTranslations, type Lang } from "@i18n/utils";
import { Icon } from "astro-icon/components";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const target: Lang = lang === "es" ? "en" : "es";

// El aviso se lee en el idioma que ofrece, no en el de la página.
const tt = useTranslations(target);
const href = getHome(target);
---

<div class="hint" data-lang-hint={target} lang={target} role="region" aria-label={tt("common.langHint.label")} hidden>
  <p class="hint__text">{tt("common.langHint.text")}</p>
  <a class="tag tag--key hint__cta" href={href} hreflang={target}>
    {tt("common.langHint.cta")}
    <Icon name="ph:arrow-right" aria-hidden="true" />
  </a>
  <button class="pill hint__close" type="button" data-lang-hint-close aria-label={tt("common.langHint.dismiss")}>
    <Icon name="ph:x" aria-hidden="true" />
  </button>
</div>

<style>
  .hint {
    position: fixed;
    z-index: 40;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 16px;
    width: max-content;
    max-width: calc(100vw - 32px);
    padding: 12px 12px 12px 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-soft);
  }
  .hint[hidden] { display: none; }

  .hint__text {
    font-size: var(--text-meta);
    color: var(--color-ink);
    margin: 0;
  }

  .hint__cta {
    gap: 8px;
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: var(--track-label-sm);
    font-size: var(--text-label-sm);
    padding: 7px 14px;
  }
  .hint__cta [data-icon] { font-size: var(--icon-sm); }

  .hint__close { flex-shrink: 0; padding: 6px; color: var(--color-ink-3); }
  .hint__close [data-icon] { font-size: var(--icon); }

  @media (max-width: 560px) {
    .hint {
      left: 16px;
      right: 16px;
      width: auto;
      transform: none;
      flex-wrap: wrap;
      border-radius: var(--radius);
      padding: 16px;
    }
    .hint__text { flex: 1 1 100%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hint { animation: hint-in 0.32s ease both; }
    @keyframes hint-in {
      from { opacity: 0; transform: translate(-50%, 12px); }
    }
    @media (max-width: 560px) {
      @keyframes hint-in {
        from { opacity: 0; transform: translateY(12px); }
      }
    }
  }
</style>

<script>
  const STORE_KEY = "preferred-lang";
  const DISMISS_KEY = "lang-hint-dismissed";

  function detectLang(): string | null {
    const langs = navigator.languages || [navigator.language];
    for (const l of langs) {
      if (l.startsWith("en")) return "en";
      if (l.startsWith("es")) return "es";
    }
    return null;
  }

  function setupLangHint() {
    const el = document.querySelector<HTMLElement>("[data-lang-hint]");
    // `astro:page-load` también dispara en la carga inicial; sin la guarda
    // los listeners se duplican.
    if (!el || el.dataset.hintReady) return;

    const target = el.dataset.langHint;
    if (localStorage.getItem(STORE_KEY) || localStorage.getItem(DISMISS_KEY)) return;
    if (detectLang() !== target) return;

    el.dataset.hintReady = "true";
    el.hidden = false;

    el.querySelector("[data-lang-hint-close]")?.addEventListener("click", () => {
      localStorage.setItem(DISMISS_KEY, "1");
      el.hidden = true;
    });

    el.querySelector(".hint__cta")?.addEventListener("click", () => {
      if (target) localStorage.setItem(STORE_KEY, target);
    });
  }

  setupLangHint();
  document.addEventListener("astro:page-load", setupLangHint);
</script>
