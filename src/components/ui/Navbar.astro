---
import { getHome, localizePath, useTranslations, type Lang } from "@i18n/utils";
import { Icon } from "astro-icon/components";
import ThemeToggle from "@ui/ThemeToggle.astro";
import LanguagePicker from "@ui/LanguagePicker.astro";

export interface Props {
  lang: Lang;
  /** Solo de paso hacia `LanguagePicker`: la ruta equivalente en el otro idioma. */
  switchTo: string;
}

const { lang, switchTo } = Astro.props;
const t = useTranslations(lang);
const home = getHome(lang);
const path = Astro.url.pathname;

/** Solo rutas reales. */
const items = [
  { href: localizePath("/notes/", lang), label: t("nav.notes"), icon: "ph:article" },
];

/** Una ruta está activa también en sus páginas de detalle, no solo en el índice. */
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="nav">
  <div class="nav__inner container">
    <a href={home} class="nav__brand" aria-label="David Herrera">
      david<span>herrera</span>
    </a>

    <nav class="nav__links" aria-label={t("nav.primaryLabel")}>
      {items.map((item) => (
        <a
          href={item.href}
          class="nav-item"
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          <Icon name={item.icon} class="nav-item__icon" aria-hidden="true" />
          {item.label}
        </a>
      ))}
      <LanguagePicker lang={lang} href={switchTo} />
      <ThemeToggle lang={lang} />
    </nav>
  </div>
</header>

<style>
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
    border-bottom: 1px solid var(--color-line);
  }

  .nav__brand {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-brand);
    color: var(--color-ink);
    flex-shrink: 0;
  }
  .nav__brand span { color: var(--color-ink-2); }

  .nav__links { display: inline-flex; align-items: center; gap: 20px; }

  .nav-item[aria-current="page"] { color: var(--color-ink); }
</style>
