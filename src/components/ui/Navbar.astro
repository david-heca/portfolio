---
import { getHome, localizePath, useTranslations, type Lang } from "@i18n/utils";
import { Icon } from "astro-icon/components";
import ThemeToggle from "@ui/ThemeToggle.astro";
import LanguagePicker from "@ui/LanguagePicker.astro";

export interface Props {
  lang: Lang;
  switchTo: string;
}

const { lang, switchTo } = Astro.props;
const t = useTranslations(lang);
const home = getHome(lang);
const path = Astro.url.pathname;
/** En la portada el nombre ya es el h1: el wordmark espera a que salga de vista. */
const isHome = path === home;

/** Solo rutas reales. */
const items = [
  { href: localizePath("/notes/", lang), label: t("nav.notes"), icon: "ph:article" },
];

/** Una ruta está activa también en sus páginas de detalle, no solo en el índice. */
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="nav">
  <div class="nav__inner container">
    <a href={home} class:list={["nav__brand", { "nav__brand--late": isHome }]} aria-label="David Herrera">
      david<span>herrera</span>
    </a>

    <nav class="nav__links" aria-label={t("nav.primaryLabel")}>
      {items.map((item) => (
        <a
          href={item.href}
          class="nav-item"
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          <Icon name={item.icon} class="nav-item__icon" aria-hidden="true" />
          {item.label}
        </a>
      ))}
      <LanguagePicker lang={lang} href={switchTo} />
      <ThemeToggle lang={lang} />
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30; /* bajo el aviso de idioma y el skip-link */
  }

  /* Velo y hairline van en la columna, no en el header: nada se sale de ella. */
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--nav-h);
    background: var(--color-glass);
    backdrop-filter: blur(var(--blur));
    border-bottom: 1px solid var(--color-line);
  }

  @supports (animation-timeline: scroll()) {
    .nav__inner {
      background-color: transparent;
      border-color: transparent;
      animation: nav-settle linear both;
      animation-timeline: scroll(root);
      animation-range: 0px var(--nav-settle);
    }
    @keyframes nav-settle {
      to { background-color: var(--color-glass); border-color: var(--color-line); }
    }
  }
  @supports (animation-timeline: scroll()) {
    .nav__brand--late {
      animation: brand-reveal linear both;
      animation-timeline: scroll(root);
      animation-range: var(--brand-reveal) calc(var(--brand-reveal) + var(--nav-settle));
    }
    @keyframes brand-reveal {
      from { opacity: 0; visibility: hidden; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__brand--late { animation: none; }
    .nav__inner {
      animation: none;
      background-color: var(--color-glass);
      border-color: var(--color-line);
    }
  }

  .nav__brand {
    font-family: var(--font-display);
    font-size: var(--text-brand);
    color: var(--color-ink);
    flex-shrink: 0;
  }
  .nav__brand span { color: var(--color-accent); }

  .nav__links { display: inline-flex; align-items: center; gap: 20px; }

  .nav-item[aria-current="page"] { color: var(--color-ink); }
</style>
