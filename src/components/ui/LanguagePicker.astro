---
import { localizePath, type Lang } from "@i18n/utils";
import { Icon } from "astro-icon/components";

export interface Props {
  lang: Lang;
  /** Muestra el nombre nativo completo ("English") en vez del código ("EN"). */
  expanded?: boolean;
}

const { lang, expanded = false } = Astro.props;
const target: Lang = lang === "es" ? "en" : "es";
const href = localizePath(Astro.url.pathname, target);

const nativeName = target === "es" ? "Español" : "English";
const label = expanded ? nativeName : target.toUpperCase();
---

<a
  href={href}
  hreflang={target}
  lang={target}
  data-target-lang={target}
  class:list={["pill", "lang-switch", expanded && "lang-switch--expanded"]}
  aria-label={target === "es" ? "Ver en español" : "View in English"}
  title={nativeName}
>
  <Icon name="ph:globe-simple-duotone" aria-hidden="true" />
  <span>{label}</span>
</a>

<style>
  .lang-switch {
    gap: 6px;
    height: 32px;
    padding: 0 8px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.12em;
  }
  /* Caja fija: evita el salto cuando acaba de cargar la mono. */
  .lang-switch [data-icon] {
    width: 15px;
    height: 15px;
    font-size: 15px;
  }
  .lang-switch span {
    line-height: 1;
    /* compensa el letter-spacing sobrante tras la última letra */
    margin-right: -0.12em;
    /* Nudge óptico: las mayúsculas no usan el hueco del descendente. */
    position: relative;
    top: 0.08em;
  }

  .lang-switch--expanded {
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }
  .lang-switch--expanded span { margin-right: -0.04em; }
</style>

<script>
  function setupLangSwitch() {
    document.querySelectorAll<HTMLAnchorElement>("[data-target-lang]").forEach((el) => {
      if (el.dataset.langReady) return;
      el.addEventListener("click", () => {
        const t = el.dataset.targetLang;
        if (t) localStorage.setItem("preferred-lang", t);
      });
      el.dataset.langReady = "true";
    });
  }
  setupLangSwitch();
  document.addEventListener("astro:page-load", setupLangSwitch);
</script>
