---
import { otherLang, useTranslations, type Lang } from "@i18n/utils";
import { Icon } from "astro-icon/components";

export interface Props {
  lang: Lang;
  /** Lo resuelve `Layout`, que ya calcula el mapeo para el hreflang: derivarlo aquí
   *  de la URL sería la segunda copia que acaba divergiendo. */
  href: string;
  /** Muestra el nombre nativo completo ("English") en vez del código ("EN"). */
  expanded?: boolean;
}

const { lang, href, expanded = false } = Astro.props;
const target = otherLang(lang);

// La etiqueta se lee en el idioma que ofrece, no en el de la página.
const tt = useTranslations(target);

const nativeName = tt("common.langHint.nativeName");
const label = expanded ? nativeName : target.toUpperCase();
---

<a
  href={href}
  hreflang={target}
  lang={target}
  data-target-lang={target}
  class:list={["pill", "lang-switch", expanded && "lang-switch--expanded"]}
  aria-label={tt("common.langHint.cta")}
  title={nativeName}
>
  <Icon name="ph:globe-simple" aria-hidden="true" />
  <span>{label}</span>
</a>

<style>
  .lang-switch {
    gap: 8px;
    height: 32px;
    padding: 0 8px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--track-label);
  }
  /* Caja fija: evita el salto cuando acaba de cargar la mono. */
  .lang-switch [data-icon] {
    width: var(--icon);
    height: var(--icon);
    font-size: var(--icon);
  }
  .lang-switch span {
    line-height: var(--leading-flat);
    /* Compensa el letter-spacing sobrante tras la última letra. Va atado al mismo
       token que lo genera: si divergen, la etiqueta se descentra en la píldora. */
    margin-right: calc(-1 * var(--track-label));
    /* Nudge óptico: las mayúsculas no usan el hueco del descendente. El valor
       coincide con --track-label-sm por casualidad; no es tracking, no lo tokenices. */
    position: relative;
    top: 0.08em;
  }

  .lang-switch--expanded {
    font-size: var(--text-sm);
    letter-spacing: var(--track-tag);
  }
  .lang-switch--expanded span { margin-right: calc(-1 * var(--track-tag)); }
</style>

<script>
  function setupLangSwitch() {
    document.querySelectorAll<HTMLAnchorElement>("[data-target-lang]").forEach((el) => {
      if (el.dataset.langReady) return;
      el.addEventListener("click", () => {
        const t = el.dataset.targetLang;
        if (t) localStorage.setItem("preferred-lang", t);
      });
      el.dataset.langReady = "true";
    });
  }
  setupLangSwitch();
  document.addEventListener("astro:page-load", setupLangSwitch);
</script>
