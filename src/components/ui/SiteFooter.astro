---
import { Icon } from "astro-icon/components";
import { getHome, useTranslations, type Lang } from "@i18n/utils";
import pkg from "../../../package.json";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = getHome(lang);

const year = new Date().getFullYear();

const channels = [
  { key: "github", href: "https://github.com/david-heca", icon: "ph:github-logo" },
  { key: "linkedin", href: "https://www.linkedin.com/in/david-heca/", icon: "ph:linkedin-logo" },
  { key: "x", href: "https://x.com/david_heca_", icon: "ph:x-logo" },
];
---

<footer class="footer">
  <div class="footer__inner container">
    <a href={`${home}#top`} class="footer__brand">david<span>herrera</span></a>

    <p class="meta">© {year} · v{pkg.version}</p>

    <div class="footer__channels">
      {channels.map((c) => (
        <a href={c.href} target="_blank" rel="noopener noreferrer" class="channel">
          <Icon name={c.icon} aria-hidden="true" />
          <span class="sr-only">{t(`common.channels.${c.key}`)}</span>
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 40px 32px;
  }
  .footer__brand {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-brand);
    color: var(--color-ink);
  }
  .footer__brand span { color: var(--color-ink-2); }

  .footer__channels {
    position: absolute;
    top: 0;
    right: calc(var(--pad) - 20px);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 24px;
    padding-inline: 20px;
    background: var(--color-bg);
  }

  .channel {
    display: grid;
    color: var(--color-ink-2);
    transition: color var(--t-fast) ease;
  }
  .channel [data-icon] { font-size: var(--icon-xl); }

  .channel:hover,
  .channel:focus-visible { color: var(--color-ink); }
</style>
