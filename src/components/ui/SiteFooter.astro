---
import { Icon } from "astro-icon/components";
import { useTranslations, type Lang } from "@i18n/utils";
import { channels } from "@/data/contact";
import pkg from "../../../package.json";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <p class="meta footer__made">
      {t("common.footer.madeWith")}
      <Icon name="ph:heart-duotone" class="footer__heart" aria-hidden="true" />
      <span class="sr-only">{t("common.footer.love")}</span>
      {t("common.footer.madeFrom")}
      <span class="footer__sep" aria-hidden="true">·</span>
      © {year}
      <span class="footer__sep" aria-hidden="true">·</span>
      v{pkg.version}
    </p>

    <ul class="footer__channels">
      {channels.map((c) => (
        <li>
          <a href={c.href} target="_blank" rel="noopener noreferrer" class="channel">
            <Icon name={c.icon} aria-hidden="true" />
            <span class="sr-only">{t(`common.channels.${c.key}`)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding-block: 24px 32px;
    border-top: 1px solid var(--color-line);
  }

  .footer__made {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-glyph);
  }
  /* Duotone sigue siendo una tinta: las dos capas son currentColor. */
  .footer__heart { font-size: var(--icon); }
  .footer__sep { color: var(--color-ink-3); }

  .footer__channels {
    display: flex;
    align-items: center;
    /* Descuenta la caja de pulgar por los cuatro lados: los glifos cierran contra
       la columna -a la derecha en una fila, a la izquierda al saltar de línea- y
       la altura de la fila la mide el texto, no la caja. */
    margin: -10px;
  }
  /* Forma: 40px de caja para el pulgar. */
  .channel {
    display: inline-flex;
    padding: 10px;
    color: var(--color-ink-2);
    border-radius: var(--radius-control);
    transition: color var(--t-fast) ease;
  }
  .channel [data-icon] { font-size: var(--icon-lg); transition: transform var(--t-base) ease; }
  .channel:hover,
  .channel:focus-visible { color: var(--color-ink); }
  .channel:hover [data-icon],
  .channel:focus-visible [data-icon] { transform: rotate(var(--icon-tilt)); }
</style>
