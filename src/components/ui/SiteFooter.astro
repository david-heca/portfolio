---
import { Icon } from "astro-icon/components";
import { useTranslations, type Lang } from "@i18n/utils";
import { channels } from "@/data/contact";
import pkg from "../../../package.json";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <p class="meta footer__made">
      {t("common.footer.madeWith")}
      <Icon name="ph:heart-duotone" class="footer__heart" aria-hidden="true" />
      <span class="sr-only">{t("common.footer.love")}</span>
      {t("common.footer.madeFrom")}
      <span class="footer__sep" aria-hidden="true">·</span>
      © {year}
      <span class="footer__sep" aria-hidden="true">·</span>
      v{pkg.version}
    </p>

    <!-- En el pie y no en la intro: es lo único que está en todas las páginas, y
         quien acaba una nota es quien busca dónde seguirte. -->
    <ul class="footer__channels">
      {channels.map((c) => (
        <li>
          <a href={c.href} target="_blank" rel="noopener noreferrer" class="channel">
            <Icon name={c.icon} aria-hidden="true" />
            <span class="sr-only">{t(`common.channels.${c.key}`)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 24px 40px;
    border-top: 1px solid var(--color-line);
  }

  /* Fuera de rejilla: dentro de una frase el hueco tiene que leerse como espacio
     de palabra, y 6px ya separa. */
  .footer__made {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  /* Duotone sigue siendo una tinta: las dos capas son currentColor, la de relleno
     al 20%. */
  .footer__heart { font-size: var(--icon); }
  .footer__sep { color: var(--color-ink-3); }

  .footer__channels {
    display: flex;
    align-items: center;
    /* Fuera de rejilla: descuenta el padding del último icono para que el glifo
       cierre contra el filo de la columna. */
    margin-right: -10px;
  }
  /* Forma: 40px de caja para el pulgar, con el glifo de 20 centrado. */
  .channel {
    display: inline-flex;
    padding: 10px;
    color: var(--color-ink-2);
    border-radius: var(--radius-control);
    transition: color var(--t-fast) ease;
  }
  .channel [data-icon] { font-size: var(--icon-lg); }
  .channel:hover,
  .channel:focus-visible { color: var(--color-ink); }
</style>
