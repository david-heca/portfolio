---
import { getHome, type Lang } from "@i18n/utils";
import pkg from "../../../package.json";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const home = getHome(lang);
---

<footer class="footer">
  <div class="footer__inner container">
    <a href={`${home}#top`} class="footer__brand">david<span>herrera</span></a>

    <p class="meta">© 2026 David Herrera · v{pkg.version}</p>
  </div>
</footer>

<style>
  /* Sin borde propio: la última sección ya cierra con su línea a todo el ancho, y
     las dos juntas se leían como un trazo de 2px. */
  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 40px 32px;
  }
  .footer__brand {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-brand);
    color: var(--color-ink);
  }
  .footer__brand span { color: var(--color-ink-2); }
</style>
