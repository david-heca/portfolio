---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { render, type CollectionEntry } from "astro:content";
import { localizePath, useTranslations, type Lang } from "@i18n/utils";

export interface Props {
  lang: Lang;
  entry: CollectionEntry<"cases">;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const index = localizePath("/cases/", lang);

const facts = [
  { label: t("cases.fields.role"), value: entry.data.role },
  { label: t("cases.fields.year"), value: entry.data.year },
  { label: t("cases.fields.status"), value: t(`projects.status.${entry.data.status}`) },
];
---

<article class="case-page section container">
  <a class="case-page__back" href={index}>
    <Icon name="ph:arrow-left" aria-hidden="true" />
    {t("cases.backToIndex")}
  </a>

  <header class="case-page__head">
    <h1 class="section-title case-page__title">{entry.data.title}</h1>
    <p class="lead case-page__summary">{entry.data.summary}</p>

    <dl class="case-page__facts">
      {facts.map((f) => (
        <div class="case-page__fact">
          <dt class="label">{f.label}</dt>
          <dd class="case-page__fact-value">{f.value}</dd>
        </div>
      ))}
    </dl>

    {entry.data.tags.length > 0 && (
      <div class="tag-row case-page__tags">
        {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}
  </header>

  {entry.data.cover && (
    <figure class="case-page__cover">
      <Image
        src={entry.data.cover}
        alt=""
        width={1200}
        height={800}
        loading="eager"
        quality={82}
      />
    </figure>
  )}

  <div class="longform case-page__body">
    <Content />
  </div>
</article>

<style>
  .case-page__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-meta);
    line-height: var(--leading-flat);
    color: var(--color-ink-2);
    transition: color var(--t-fast) ease;
  }
  .case-page__back:hover { color: var(--color-accent); }
  .case-page__back [data-icon] { font-size: var(--icon); }

  .case-page__head {
    max-width: 720px;
    margin-top: 32px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-line);
  }
  .case-page__title { --display-size: var(--display-lg); --display-leading: 0.98; }
  .case-page__summary { margin-top: 20px; }

  .case-page__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 48px;
    margin-top: 32px;
  }
  .case-page__fact-value {
    font-size: var(--text-sm);
    color: var(--color-ink);
    margin-top: 4px;
  }

  .case-page__tags { margin-top: 24px; }

  .case-page__cover { margin-top: 48px; }
  .case-page__cover img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-line);
  }

  .case-page__body { margin-top: 56px; }
</style>
