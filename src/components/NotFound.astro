---
import { Icon } from "astro-icon/components";
import { getHome, useTranslations, type Lang } from "@i18n/utils";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = getHome(lang);
---

<section class="notfound container">
  <p class="section-title notfound__num">404</p>
  <h1 class="section-title notfound__title">{t("notFound.subtitle")}</h1>
  <p class="prose notfound__desc">{t("notFound.description")}</p>
  <div class="notfound__actions">
    <a href={home} class="btn btn--primary">
      <Icon name="ph:house-duotone" aria-hidden="true" />
      {t("notFound.homeButton")}
    </a>
    <!-- Oculto salvo que el referrer sea de este sitio: si no, "volver" no lleva a ninguna parte. -->
    <button type="button" data-back class="btn btn--ghost" hidden>
      <Icon name="ph:arrow-left-duotone" aria-hidden="true" />
      {t("notFound.backButton")}
    </button>
  </div>
</section>

<style>
  .notfound {
    padding-top: clamp(80px, 14vw, 160px);
    padding-bottom: clamp(80px, 14vw, 160px);
    max-width: 640px;
  }
  .notfound__num {
    --display-size: var(--display-2xl);
    --display-leading: 0.85;
    color: var(--color-accent);
    margin: 0;
  }
  .notfound__title { margin-top: 24px; }
  .notfound__desc { margin-top: 16px; max-width: 48ch; }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  .notfound__actions .btn[hidden] { display: none; }
</style>

<script>
  function setupBack() {
    const btn = document.querySelector<HTMLButtonElement>("[data-back]");
    if (!btn || btn.dataset.ready) return;

    let sameOrigin = false;
    try {
      sameOrigin =
        !!document.referrer &&
        new URL(document.referrer).origin === window.location.origin;
    } catch {}
    if (!sameOrigin) return;

    btn.hidden = false;
    btn.addEventListener("click", () => history.back());
    btn.dataset.ready = "true";
  }

  setupBack();
  document.addEventListener("astro:page-load", setupBack);
</script>
