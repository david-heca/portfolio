---
import { Icon } from "astro-icon/components";
import { getHome, useTranslations, type Lang } from "@i18n/utils";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = getHome(lang);
---

<section class="notfound section container">
  <p class="rail">{t("notFound.heading")}</p>
  <h1 class="page-title notfound__title">{t("notFound.subtitle")}</h1>
  <p class="prose notfound__desc">{t("notFound.description")}</p>
  <p class="notfound__home">
    <a href={home} class="link">
      <Icon name="ph:arrow-left" aria-hidden="true" />
      {t("notFound.homeButton")}
    </a>
  </p>
</section>

<style>
  .notfound__title { margin-top: 8px; }
  .notfound__desc { margin-top: 12px; }
  .notfound__home { margin-top: 24px; font-size: var(--text-meta); }
</style>

