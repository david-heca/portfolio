---
import NoteList from "@ui/NoteList.astro";
import { useTranslations, type Lang } from "@i18n/utils";
import { localizedEntries } from "@/data/collections";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = await localizedEntries("notes", lang);
---

<section class="section container">
  <header class="sec-head">
    <h1 class="page-title">{t("notes.title")}</h1>
    <p class="prose">{t("notes.description")}</p>
  </header>

  {items.length === 0 ? (
    <p class="prose">{t("notes.empty")}</p>
  ) : (
    <NoteList lang={lang} items={items} />
  )}
</section>
