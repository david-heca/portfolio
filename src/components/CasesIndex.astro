---
import { Image } from "astro:assets";
import { localizePath, useTranslations, type Lang } from "@i18n/utils";
import { localizedEntries } from "@/data/collections";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = await localizedEntries("cases", lang);
const base = localizePath("/cases/", lang);
---

<section class="section container">
  <header class="sec-head reveal">
    <h1 class="section-title">{t("cases.title")}</h1>
    <p class="lead">{t("cases.description")}</p>
  </header>

  {items.length === 0 ? (
    <p class="prose reveal">{t("cases.empty")}</p>
  ) : (
    <ul class="index-list">
      {items.map(({ slug, entry }, i) => (
        <li class:list={["index-row", "reveal", `reveal-${Math.min(i + 1, 3)}`]}>
          <a class="index-row__link" href={`${base}${slug}/`}>
            <span class="rail index-row__rail">{entry.data.year}</span>

            <span class="index-row__body">
              <span class="card-title index-row__title">{entry.data.title}</span>
              <span class="prose-sm index-row__summary">{entry.data.summary}</span>
              {entry.data.tags.length > 0 && (
                <span class="tag-row index-row__tags">
                  {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                </span>
              )}
            </span>

            {entry.data.cover && (
              <span class="index-row__media">
                <Image
                  src={entry.data.cover}
                  alt=""
                  width={480}
                  height={360}
                  loading="lazy"
                  quality={80}
                />
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .index-list { display: flex; flex-direction: column; }

  .index-row + .index-row { border-top: 1px solid var(--color-line); }

  .index-row__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    padding-block: 32px;
    align-items: start;
  }
  @media (min-width: 768px) {
    .index-row__link { grid-template-columns: 72px minmax(0, 1fr) 160px; gap: 32px; }
  }

  /* Alineación óptica: el año se apoya en la primera línea del título, que tiene
     más cuerpo. Fuera de rejilla a propósito. */
  .index-row__rail { padding-top: 6px; }

  .index-row__body { display: block; }
  .index-row__title { display: block; transition: color var(--t-fast) ease; }
  .index-row__summary { display: block; margin-top: 10px; max-width: 56ch; }
  .index-row__tags { margin-top: 16px; }

  .index-row__media { display: none; }
  @media (min-width: 768px) {
    .index-row__media { display: block; }
    .index-row__media img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: var(--radius-sm);
      border: 1px solid var(--color-line);
    }
  }

  .index-row__link:hover .index-row__title,
  .index-row__link:focus-visible .index-row__title { color: var(--color-accent); }
</style>
